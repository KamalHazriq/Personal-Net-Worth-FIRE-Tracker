# Optional settings for the local API server. Copy to ".env" if you need them.
# The app works fully offline with no configuration at all.

# Override the API server port (default 8787).
# SERVER_PORT=8787

# Which address to listen on. The default, 127.0.0.1, means this machine only.
#
#   tailscale   this machine's Tailscale address, so your own phone can reach
#               it over your private tailnet (see "Using it on your phone" in
#               the README). Requires a passcode to be set.
#   0.0.0.0     every network this machine is on, including public wifi. Not
#               recommended: there is no HTTPS, so anyone on the same network
#               can read the traffic.
#
# `npm run phone` sets this to tailscale for you, so you rarely need it here.
# SERVER_HOST=tailscale

# How long a phone or browser stays unlocked after entering the passcode,
# in days (default 14). Sessions also end whenever the server restarts.
# SESSION_DAYS=14
